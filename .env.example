# Local Ollama placeholder; never put a real credential in this tracked file.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b-lowctx
# Seconds per request: fail fast when unreachable, allow CPU inference longer.
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120
